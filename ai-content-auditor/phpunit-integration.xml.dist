<?xml version="1.0"?>
<!-- Integration tests: WordPress test suite (wp-env provides WP_TESTS_DIR). -->
<phpunit
	bootstrap="tests/integration/bootstrap.php"
	colors="true"
	backupGlobals="false"
>
	<testsuites>
		<testsuite name="integration">
			<directory suffix="Test.php">tests/integration</directory>
		</testsuite>
	</testsuites>
</phpunit>
