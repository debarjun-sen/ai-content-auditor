<?xml version="1.0"?>
<!-- Unit tests: pure PHP, no WordPress or database required. -->
<phpunit
	bootstrap="tests/unit/bootstrap.php"
	colors="true"
	beStrictAboutOutputDuringTests="true"
	failOnWarning="true"
>
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">tests/unit</directory>
		</testsuite>
	</testsuites>
	<coverage>
		<include>
			<directory suffix=".php">includes</directory>
		</include>
	</coverage>
</phpunit>
