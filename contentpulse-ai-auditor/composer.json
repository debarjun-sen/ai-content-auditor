{
	"name": "contentpulse-ai-auditor/contentpulse-ai-auditor",
	"description": "Claude-powered SEO, accessibility and stale-content auditing agent for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"test": "@test:unit",
		"test:unit": "phpunit -c phpunit.xml.dist",
		"test:integration": "phpunit -c phpunit-integration.xml.dist",
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	}
}
