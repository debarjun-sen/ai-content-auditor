{
	"name": "ai-content-auditor-workspace",
	"private": true,
	"description": "Workspace for the AI Content Auditor WordPress plugin and its demo companion.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:reset": "wp-env clean all",
		"demo:seed": "wp-env run cli wp aica-demo seed",
		"demo:reset": "wp-env run cli wp aica-demo reset",
		"demo:audit": "wp-env run cli wp aica audit --mode=quick",
		"demo:audit:ai": "wp-env run cli wp aica audit --mode=ai --max-posts=8",
		"composer:install": "wp-env run tests-cli --env-cwd=wp-content/plugins/ai-content-auditor composer install",
		"test:unit": "wp-env run tests-cli --env-cwd=wp-content/plugins/ai-content-auditor composer test:unit",
		"test:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/ai-content-auditor composer test:integration",
		"test": "npm run test:unit && npm run test:integration",
		"lint:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/ai-content-auditor composer lint",
		"lint:js": "node --check ai-content-auditor/assets/admin.js",
		"playground": "npx @wp-playground/cli@latest server --mount=./ai-content-auditor:/wordpress/wp-content/plugins/ai-content-auditor --mount=./ai-content-auditor-demo:/wordpress/wp-content/plugins/ai-content-auditor-demo --blueprint=./blueprint.local.json",
		"build": "node bin/build.mjs"
	},
	"devDependencies": {
		"@wordpress/env": "^10.0.0"
	}
}
